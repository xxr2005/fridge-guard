<!-- pages/add/add.wxml -->
<view class="page">
  <view class="photo" bindtap="onChoosePhoto">
    <image wx:if="{{photoPath}}" class="photo-img" src="{{photoPath}}" mode="aspectFill" />
    <view wx:else class="photo-placeholder">拍张照备忘（可选）</view>
  </view>

  <view class="section-title">选择食物</view>
  <scroll-view class="food-scroll" scroll-y>
    <van-cell-group inset>
      <van-cell
        wx:for="{{foodList}}"
        wx:key="name"
        center
        data-name="{{item.name}}"
        bindtap="onSelectFood"
        custom-class="{{selectedFood && selectedFood.name === item.name ? 'food-item-active' : ''}}"
      >
        <image slot="icon" class="food-img" src="{{item.imageUrl}}" mode="aspectFill" />
        <text slot="title" class="food-name {{selectedFood && selectedFood.name === item.name ? 'food-name-active' : ''}}">{{item.name}}</text>
        <van-tag wx:if="{{!item.fridgeOk}}" slot="right-icon" type="danger" plain>不宜冷藏</van-tag>
      </van-cell>
    </van-cell-group>
  </scroll-view>

  <view wx:if="{{selectedFood}}" class="advice {{selectedFood.fridgeOk ? 'advice-ok' : 'advice-no'}}">
    <block wx:if="{{selectedFood.fridgeOk}}">
      <text>{{adviceText}}</text>
    </block>
    <block wx:else>
      <text class="advice-title">不建议放冰箱</text>
      <text class="advice-reason">{{selectedFood.noFridgeReason}}</text>
    </block>
  </view>

  <view class="confirm">
    <van-button type="primary" block bindtap="onConfirm">确认放入冰箱</van-button>
  </view>
</view>
