/* pages/add/add.wxss */
.page {
  padding: 24rpx;
  box-sizing: border-box;
}

.photo {
  width: 240rpx;
  height: 240rpx;
  border: 2rpx dashed #999;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-placeholder {
  color: #999;
  font-size: 28rpx;
}

.section-title {
  margin: 32rpx 0 16rpx;
  font-size: 32rpx;
  color: #333;
}

.food-scroll {
  height: 480rpx;
}

.food-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.food-name {
  font-size: 30rpx;
  color: #333;
}

.food-item-active {
  background: #eaf4ff !important;
}

.food-name-active {
  color: #2b7bd6;
}

.advice {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  display: flex;
  flex-direction: column;
}

.advice-ok {
  background: #e7f7ec;
  color: #1e8e3e;
}

.advice-no {
  background: #fdecec;
  color: #d64545;
}

.advice-title {
  font-weight: bold;
}

.advice-reason {
  margin-top: 8rpx;
  font-size: 28rpx;
}

.confirm {
  margin-top: 32rpx;
}
