/* pages/index/index.wxss */
.page {
  padding: 24rpx 24rpx 180rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.thumb-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e0e0e0;
  color: #999;
  font-size: 24rpx;
}

.name {
  font-size: 32rpx;
  color: #333;
}

.meta {
  margin-top: 8rpx;
}

.cell-right {
  margin-left: 16rpx;
}

.empty-wrap {
  padding-top: 80rpx;
}

.footer {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
}
