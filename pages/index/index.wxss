/* pages/index/index.wxss */
.page {
  padding: 24rpx 24rpx 180rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  border-left: 8rpx solid transparent;
}

.card-ok {
  background: #eafaf0;
  border-left-color: #1e8e3e;
}

.card-warn {
  background: #fff7e0;
  border-left-color: #e6a23c;
}

.card-expired {
  background: #fdeaea;
  border-left-color: #d64545;
}

.card-fridge-off {
  background: #eef2f6;
  border-left-color: #8a9bb0;
}

.thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.thumb-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e0e0e0;
  color: #999;
  font-size: 24rpx;
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.name {
  font-size: 32rpx;
  color: #333;
}

.remain {
  margin-top: 8rpx;
  font-size: 28rpx;
}

.card-ok .remain {
  color: #1e8e3e;
}

.card-warn .remain {
  color: #e6a23c;
}

.card-expired .remain {
  color: #d64545;
}

.card-fridge-off .remain {
  color: #6b7a8a;
}

.eaten {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #555;
  background: #fff;
  border: 1rpx solid #bbb;
  border-radius: 12rpx;
}

.eaten::after {
  border: none;
}

.empty {
  padding: 160rpx 0;
  text-align: center;
  color: #999;
  font-size: 30rpx;
}

.add-fixed {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  background: #2b7bd6;
  color: #fff;
  border-radius: 12rpx;
}

.add-fixed::after {
  border: none;
}
